# Copy to .env.local and fill in. EXPO_PUBLIC_* values are bundled into the app,
# so only public keys go here (never the service role key or Anthropic key).
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google Sign-In (optional; leave blank to hide the Google button)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
GOOGLE_IOS_URL_SCHEME=
